{
    "layer": "top",

    "modules-left": ["battery", "network"],
    "modules-center": ["niri/window"],
    "modules-right": ["custom/lang", "pulseaudio", "clock"],

    "niri/window": {
        "max-length": 50
    },
    "custom/lang": {
        "exec": "niri msg keyboard-layouts | awk '/^ \\* /{print $3}' | sed 's|Polish|pl|;s|Russian|ru|'",
        "interval": 1,
        "format": "{}",
        "tooltip": false
    },

    "battery": {
        "format": "{capacity}%",
    },
    "network": {
        "interface": "wlp2s0",
        "format-ethernet": "eth  >{bandwidthUpBits}  &lt;{bandwidthDownBits}",
        "format-wifi": "{essid}  >{bandwidthUpBits}  &lt;{bandwidthDownBits}",
        "format-disconnected": "disconnected",
        "interval": 2
    },
    "clock": {
        "format": "{:%a, %d. %b  %H:%M}",
        "format-alt": "{:%a, %d. %b  %H:%M}",
    },
    "pulseaudio": {
        "format": "{volume}%",
        "format-muted": "{volume}%",
    },
}
